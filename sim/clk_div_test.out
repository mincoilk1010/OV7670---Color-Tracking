P_0x65115dda3760 .param/l "FREQ_OUT" 0 4 4, +C4<00000000000000000000000000011001>;
v0x65115dddf180_0 .net "arstn", 0 0, v0x65115ddf3b10_0;  1 drivers
v0x65115ddf3820_0 .net "clk_in", 0 0, v0x65115ddf3be0_0;  1 drivers
v0x65115ddf38e0_0 .var "clk_out", 0 0;
v0x65115ddf39b0_0 .var "cnt", 0 0;
E_0x65115dda4610/0 .event negedge, v0x65115dddf180_0;
E_0x65115dda4610/1 .event posedge, v0x65115ddf3820_0;
E_0x65115dda4610 .event/or E_0x65115dda4610/0, E_0x65115dda4610/1;
    .scope S_0x65115dda3500;
T_0 ;
    %wait E_0x65115dda4610;
    %load/vec4 v0x65115dddf180_0;
    %inv;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x65115ddf38e0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x65115ddf39b0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x65115ddf39b0_0;
    %pad/u 2;
    %addi 1, 0, 2;
    %pad/u 1;
    %assign/vec4 v0x65115ddf39b0_0, 0;
    %load/vec4 v0x65115ddf39b0_0;
    %pad/u 65;
    %cmpi/e 1, 0, 65;
    %jmp/0xz  T_0.2, 4;
    %load/vec4 v0x65115ddf38e0_0;
    %inv;
    %assign/vec4 v0x65115ddf38e0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x65115ddf39b0_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x65115dddeff0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65115ddf3be0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x65115ddf3b10_0, 0, 1;
    %end;
    .thread T_1, $init;
    .scope S_0x65115dddeff0;
T_2 ;
T_2.0 ;
    %delay 5000, 0;
    %load/vec4 v0x65115ddf3be0_0;
    %inv;
    %store/vec4 v0x65115ddf3be0_0, 0, 1;
    %jmp T_2.0;
