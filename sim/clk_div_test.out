    .thread T_2;
    .scope S_0x65115dddeff0;
T_3 ;
    %vpi_call/w 3 22 "$dumpfile", "clk_div_test.vcd" {0 0 0};
    %vpi_call/w 3 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x65115dddeff0 {0 0 0};
    %pushi/vec4 1, 0, 1;
