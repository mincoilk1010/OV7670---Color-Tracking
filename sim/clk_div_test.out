:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x65115dddee60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x65115dddeff0 .scope module, "clk_div_tb" "clk_div_tb" 3 3;
 .timescale -9 -12;
v0x65115ddf3b10_0 .var "arstn", 0 0;
v0x65115ddf3be0_0 .var "clk_in", 0 0;
v0x65115ddf3cb0_0 .net "clk_out", 0 0, v0x65115ddf38e0_0;  1 drivers
